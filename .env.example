# ==============================================================================
# TalentAI — Production Environment Template (.env.example)
# Copy this file to '.env' and populate with your production secrets.
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Environment Mode
# ------------------------------------------------------------------------------
APP_NAME=TalentAI
APP_VERSION=1.0.0
# Set to 'production' to enforce HTTPS secure cookies and strict security policies
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Security & Session Secret
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-character secret using: openssl rand -hex 32
SECRET_KEY=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_HEX_32
SESSION_COOKIE_NAME=talentai_session
SESSION_MAX_AGE_SECONDS=86400
# Leave empty to automatically enforce Secure cookies when ENVIRONMENT=production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Origins
# ------------------------------------------------------------------------------
# Unified public HTTPS origin(s) (comma-separated, no trailing slashes)
# In unified Nginx deployment, this is your single public HTTPS domain
ALLOWED_ORIGINS=https://talentai.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Internal MongoDB container credentials (used by docker-compose and backend)
MONGO_INITDB_ROOT_USERNAME=talentai_admin
MONGO_INITDB_ROOT_PASSWORD=PLACEHOLDER_STRONG_MONGODB_PASSWORD
MONGODB_URI=mongodb://talentai_admin:PLACEHOLDER_STRONG_MONGODB_PASSWORD@mongodb:27017/talentai?authSource=admin
MONGODB_DATABASE=talentai

# ------------------------------------------------------------------------------
# 5. Local AI Service (Ollama & Qwen 8B)
# ------------------------------------------------------------------------------
# Ollama service endpoint:
# If Ollama is running on the host system with GPU acceleration: http://host.docker.internal:11434
# If Ollama is running locally on the same server: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_CONNECT=10.0
OLLAMA_TIMEOUT_READ=300.0
OLLAMA_MAX_RETRIES=2
OLLAMA_RECOVERY_TIMEOUT_SECONDS=60.0
OLLAMA_HEALTH_CHECK_INTERVAL=2.0
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024

# On-demand AI Lifecycle Management
OLLAMA_AUTO_LIFECYCLE=true
OLLAMA_IDLE_TIMEOUT_SECONDS=300
OLLAMA_STARTUP_TIMEOUT_SECONDS=60.0
OLLAMA_COMMAND=ollama serve

# ------------------------------------------------------------------------------
# 6. File Storage & Security Limits
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/data/uploads
EXTRACTED_DIR=/app/data/extracted
FAILED_DIR=/app/data/failed
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.zip

MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_REQUEST=500
MAX_REQUEST_BODY_SIZE_MB=100
MAX_RESUMES_PER_BATCH=500
MAX_ZIP_MEMBERS_COUNT=1000
MAX_ZIP_UNCOMPRESSED_SIZE_MB=250
MAX_ZIP_COMPRESSION_RATIO=20.0

# ------------------------------------------------------------------------------
# 7. Automated Retention & Cleanup
# ------------------------------------------------------------------------------
BATCH_RETENTION_HOURS=24
BATCH_CLEANUP_INTERVAL_MINUTES=60

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Account Protection
# ------------------------------------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
